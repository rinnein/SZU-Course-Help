# Optional: store runtime data outside the source tree.
COURSE_SELECT_DATA_DIR=./runtime-data
COURSE_SELECT_DB_PATH=./runtime-data/course_enroll.db
COURSE_SELECT_KEY_DIR=./runtime-data/keys
COURSE_SELECT_PORT=8000

# Optional: encrypt the locally generated Ed25519 private key.
# COURSE_SELECT_KEY_PASSPHRASE=replace-with-a-local-secret

# Optional PaddleOCR target-text fallback.
# COURSE_SELECT_USE_PADDLE_OCR=1
